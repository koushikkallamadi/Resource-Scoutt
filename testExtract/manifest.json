{
  "manifest_version": 3,
  "name": "ResourceScout – Restriction Detector & Resource Saver",
  "version": "1.0.0",
  "description": "Scans page restrictions (0-100 score) and extracts accessible PDFs, images, media & canvases.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "webRequest",
    "offscreen"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "ResourceScout"
  },
  "options_page": "src/options/index.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["mainWorld.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["mainWorld.js", "default-rubric.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
